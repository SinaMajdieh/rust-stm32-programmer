    out property <color> window-background: #0b111c;
    out property <color> panel-background: #111827;
    out property <color> log-background: #080d16;
    out property <color> log-row-background: #0b111c;
    out property <color> border: #263244;

    out property <color> text-primary: #f8fafc;
    out property <color> text-normal: #e2e8f0;
    out property <color> text-muted: #64748b;
    out property <color> text-faint: #475569;
    out property <color> text-log: #d6deeb;

    out property <color> blue: #1d4ed8;
    out property <color> blue-light: #93c5fd;
    out property <color> green: #4ade80;
    out property <color> amber: #f59e0b;

    out property <length> card-radius: 10px;
    out property <length> card-border-width: 1px;
}