import { Palette } from "../../styling/style.slint";
import { ProjectButton } from "./project-button.slint";
import { RecentProjectItem } from "./recent-project-item.slint";
import { Navigation } from "../../navigation.slint";
import { Screen } from "../../screen.slint";
import { ProjectAction } from "project-action.slint";

export component Project inherits Rectangle {
    preferred-width: 750px;
    preferred-height: 450px;

    background: Palette.background;

    VerticalLayout {
        HorizontalLayout {
            padding: 20px;
            spacing: 16px;

            vertical-stretch: 0;
            alignment: center;

            ProjectButton {
                title: "New Project";
                subtitle: "Create a new project";
                icon: "+";

                clicked => {
                    ProjectAction.new-project();
                }
            }

            ProjectButton {
                title: "Open Project";
                subtitle: "Open an existing project";
                icon: "↗";

                clicked => {
                    ProjectAction.open-project();
                }
            }
        }

        // ─────────────────────────────────────────
        // Recent projects
        // ─────────────────────────────────────────

        VerticalLayout {
            padding: 16px;
            spacing: 8px;
            alignment: start;
            vertical-stretch: 0;

            Text {
                text: "Recent Projects";
                font-size: 15px;
                font-weight: 600;
                color: Palette.text-secondary;
            }

            RecentProjectItem {
                name: "STM32 Blinky";
                path: "~/Projects/stm32-blinky";
                target: "STM32F103C8T6";
                last-opened: "Just now";

                clicked => {
                    ProjectAction.open-recent-project(self.path);
                }
            }

            RecentProjectItem {
                name: "Motor Controller";
                path: "~/Projects/motor-controller";
                target: "STM32F103C8T6";
                last-opened: "Yesterday";

                clicked => {
                    ProjectAction.open-recent-project(self.path);
                }
            }

            RecentProjectItem {
                name: "Temperature Sensor";
                path: "~/Projects/temperature-sensor";
                target: "STM32F103C8T6";
                last-opened: "3 days ago";

                clicked => {
                    ProjectAction.open-recent-project(self.path);
                }
            }
        }

        // Consume remaining space.
        // Rectangle {
        //     vertical-stretch: 1;
        // }
    }
}
