import { AppPalette } from "../../styling/style.slint";

export component RecentProjectItem inherits Rectangle {
    in property <string> name;
    in property <string> path;
    in property <string> target;
    in property <string> last-opened;
    in property <bool> enabled: true;

    callback clicked();

    width: 100%;
    height: 68px;

    background: touch-area.pressed
        ? AppPalette.surface-hover
        : touch-area.has-hover
            ? AppPalette.surface-hover
            : AppPalette.surface;

    border-radius: 4px;

    HorizontalLayout {
        padding: 16px;
        spacing: 14px;

        // Project icon
        Rectangle {
            width: 36px;
            height: 36px;

            background: AppPalette.background;
            border-radius: 4px;

            Text {
                text: "▣";
                color: AppPalette.text-secondary;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Project information
        VerticalLayout {
            spacing: 3px;
            alignment: center;

            Text {
                text: root.name;
                color: AppPalette.text-primary;
                font-size: 14px;
                font-weight: 600;
            }

            Text {
                text: root.path;
                color: AppPalette.text-secondary;
                font-size: 12px;
            }
        }

        // Push metadata to the right
        Rectangle {
            horizontal-stretch: 1;
        }

        VerticalLayout {
            alignment: center;

            Text {
                text: root.target;
                color: AppPalette.text-secondary;
                font-size: 12px;
                horizontal-alignment: right;
            }

            Text {
                text: root.last-opened;
                color: AppPalette.text-secondary;
                font-size: 11px;
                horizontal-alignment: right;
            }
        }
    }

    touch-area := TouchArea {
        enabled: root.enabled;

        clicked => {
            root.clicked();
        }
    }

    opacity: root.enabled ? 1.0 : 0.45;
}
