// ─────────────────────────────────────────────────────────────
// Generate Firmware Panel
// ─────────────────────────────────────────────────────────────

component GenerateFirmwarePanel inherits Rectangle {
    in property <[string]> targets;
    in property <[string]> templates;
    in property <[string]> models;

    in-out property <int> target-index: 0;
    in-out property <int> template-index: 0;
    in-out property <int> model-index: 0;
    in-out property <string> prompt;

    callback run(string, string, string, string);

    VerticalLayout {
        width: 640px;

        alignment: center;
        cross-axis-alignment: center;

        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;

        VerticalLayout {
            alignment: start;
            cross-axis-alignment: stretch;

            padding-left: 10px;
            padding-right: 10px;
            padding-top: 10px;
            padding-bottom: 10px;

            spacing: 16px;

            Text {
                text: "Generate Firmware";

                vertical-alignment: center;
                horizontal-alignment: center;

                font-weight: 600;
                font-size: 20px;
                color: AppPalette.text-secondary;
            }

            Text {
                text: "Configure your target and describe the firmware you want to generate.";

                vertical-alignment: center;
                horizontal-alignment: center;

                font-weight: 400;
                font-size: 13px;
                color: AppPalette.text-secondary;
            }

            HorizontalLayout {
                spacing: 12px;

                LabeledComboBox {
                    label: "Target";
                    model: root.targets;
                    current-index <=> root.target-index;
                }

                LabeledComboBox {
                    label: "Template";
                    model: root.templates;
                    current-index <=> root.template-index;
                }

                LabeledComboBox {
                    label: "Model";
                    model: root.models;
                    current-index <=> root.model-index;
                }
            }
            VerticalLayout {
                alignment: stretch;
                cross-axis-alignment: stretch;
                TextEdit {
                    width: 100%;
                    height: 200px;
                    font-size: 14px;
                    placeholder-text: "What do you want to build?";
                    text <=> root.prompt;
                }
            }
            HorizontalLayout {
                alignment: end;
                Button {
                    text: "Generate and Program";
                    primary: true;
                    clicked => {
                        if root.target-index >= 0
                            && root.target-index < root.targets.length
                            && root.template-index >= 0
                            && root.template-index < root.templates.length
                            && root.model-index >= 0
                            && root.model-index < root.models.length
                        {
                            root.run(
                                root.targets[root.target-index],
                                root.templates[root.template-index],
                                root.models[root.model-index],
                                root.prompt
                            );
                        }
                    }
                }
            }
        }
    }
}

export component Generation inherits Rectangle {
    in property <[string]> targets;
    in property <[string]> templates;
    in property <[string]> models;

    in-out property <int> target-index: 0;
    in-out property <int> template-index: 0;
    in-out property <int> model-index: 0;
    in-out property <string> prompt;

    // The callbacks now send the actual selected string.
    callback target-changed(string);
    callback template-changed(string);
    callback model-changed(string);
    callback run(string, string, string, string);


    // // ─────────────────────────────────────────────────────────
    // // Selection changes
    // // ─────────────────────────────────────────────────────────

    changed target-index => {
        if target-index >= 0 && target-index < targets.length {
            target-changed(targets[target-index]);
        }
    }

    changed template-index => {
        if template-index >= 0 && template-index < templates.length {
            template-changed(templates[template-index]);
        }
    }

    changed model-index => {
        if model-index >= 0 && model-index < models.length {
            model-changed(models[model-index]);
        }
    }

    // // ─────────────────────────────────────────────────────────
    // // Layout
    // // ─────────────────────────────────────────────────────────

    VerticalLayout {
        // StudioAppBar {}

        Rectangle {
            GenerateFirmwarePanel {
                targets: root.targets;
                templates: root.templates;
                models: root.models;

                target-index <=> root.target-index;
                template-index <=> root.template-index;
                model-index <=> root.model-index;
                prompt <=> root.prompt;

                run(target, template, model, prompt) => {
                    root.run(target, template, model, prompt);
                }
            }
        }
    }
}
