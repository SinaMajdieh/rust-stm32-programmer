import { Theme } from "../theme.slint";

export component PipelineNode inherits Rectangle {
    in property<string> label;
    in property<int> index;
    in property<int> active-stage;

    width: 88px;
    height: 60px;

    Rectangle {
        x: 31px;
        y: 0;
        width: 26px;
        height: 26px;
        border-radius: 13px;
        background: root.active-stage >= root.index ? Theme.accent : Theme.surface-2;
        border-width: 1px;
        border-color: root.active-stage >= root.index ? Theme.accent : Theme.border;

        Text {
            width: parent.width;
            height: parent.height;
            text: root.active-stage >= root.index ? "✓" : "";
            color: #0d1014;
            font-family: Theme.font-ui;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: -12px;
        y: 34px;
        width: parent.width + 24px;
        height: 20px;
        text: root.label;
        color: root.active-stage >= root.index ? Theme.text : Theme.text-muted;
        font-family: Theme.font-ui;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
