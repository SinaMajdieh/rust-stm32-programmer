import { Theme } from "../theme.slint";
import { StatusDot, StatusState } from "status-dot.slint";

export component StatusBar inherits Rectangle {
    in property<string> message: "Ready";
    in property<bool> connected: true;

    height: 36px;
    background: Theme.surface;

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }

    StatusDot {
        x: 18px;
        y: 14px;
        state: root.connected ? StatusState.success : StatusState.muted;
    }

    Text {
        x: 34px;
        y: 7px;
        width: 280px;
        height: 22px;
        text: root.message;
        color: Theme.text-secondary;
        font-family: Theme.font-ui;
        font-size: 10px;
        vertical-alignment: center;
    }

    Text {
        x: parent.width - 410px;
        y: 7px;
        width: 392px;
        height: 22px;
        text: "STM32F1   •   OpenOCD   •   arm-none-eabi-gcc";
        color: Theme.text-muted;
        font-family: Theme.font-mono;
        font-size: 9px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}
