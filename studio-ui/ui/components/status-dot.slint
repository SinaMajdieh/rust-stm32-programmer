import { Theme } from "../theme.slint";

export enum StatusState {
    success,
    warning,
    error,
    muted,
}

export component StatusDot inherits Rectangle {
    in property<StatusState> state: StatusState.muted;

    width: 8px;
    height: 8px;
    border-radius: 4px;

    background: {
        if (root.state == StatusState.success) {
            Theme.success
        } else if (root.state == StatusState.warning) {
            Theme.warning
        } else if (root.state == StatusState.error) {
            Theme.error
        } else {
            Theme.text-muted
        }
    }
}
