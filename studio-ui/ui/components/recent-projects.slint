import { Theme } from "../theme.slint";
import { RecentProjectRow } from "recent-project-row.slint";

export component RecentProjects inherits Rectangle {
    callback selected(string);

    width: 720px;
    height: 130px;
    background: transparent;

    Text {
        x: 0;
        y: 0;
        text: "Recent projects";
        color: Theme.text-secondary;
        font-family: Theme.font-ui;
        font-size: 11px;
        font-weight: 700;
    }

    RecentProjectRow {
        x: 0;
        y: 28px;
        name: "LED Blinker";
        time: "2 min ago";
        selected => { root.selected("Make the onboard LED blink every 500ms"); }
    }

    RecentProjectRow {
        x: 0;
        y: 70px;
        name: "UART Temperature Sensor";
        time: "Yesterday";
        selected => { root.selected("Read a temperature sensor over UART and print the value every second"); }
    }
}
