import { Theme } from "../theme.slint";
import { TextEdit } from "std-widgets.slint";
import { PrimaryButton } from "primary-button.slint";

export component PromptBox inherits Rectangle {
    in-out property<string> prompt;
    in property<bool> enabled: true;
    callback generate-and-flash;

    width: 720px;
    height: 174px;
    background: Theme.surface;
    border-width: 1px;
    border-color: input-area.has-focus ? Theme.border-strong : Theme.border;
    border-radius: Theme.radius-large;

    Text {
        x: 20px;
        y: 16px;
        text: "Describe what you want to build";
        color: Theme.text-secondary;
        font-family: Theme.font-ui;
        font-size: 11px;
        font-weight: 700;
    }

    input-area := TextEdit {
        x: 20px;
        y: 42px;
        width: parent.width - 40px;
        height: 64px;
        text <=> root.prompt;
        enabled: root.enabled;
        font-family: Theme.font-ui;
        font-size: 15px;
        // color: Theme.text;
        // background: transparent;
        wrap: word-wrap;
        placeholder-text: "Make the onboard LED blink every 500ms";
    }

    Rectangle {
        x: 20px;
        y: 117px;
        width: parent.width - 40px;
        height: 1px;
        background: Theme.border;
    }

    Text {
        x: 20px;
        y: 129px;
        width: parent.width - 202px;
        height: 30px;
        text: "Generates the project, builds it, then programs the connected board.";
        color: Theme.text-muted;
        font-family: Theme.font-ui;
        font-size: 10px;
        wrap: word-wrap;
        vertical-alignment: center;
    }

    PrimaryButton {
        x: parent.width - 178px;
        y: 124px;
        text: "Generate & Flash";
        enabled: root.enabled && root.prompt != "";
        clicked => { root.generate-and-flash(); }
    }
}
