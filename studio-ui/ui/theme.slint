// Centralized visual tokens. Keep all palette, typography, spacing, and radius
// decisions here so the application can be restyled without editing components.
export global Theme {
    in-out property<color> background: #0d0f12;
    in-out property<color> surface: #13161a;
    in-out property<color> surface-2: #181c21;
    in-out property<color> surface-3: #1e2329;
    in-out property<color> border: #252a31;
    in-out property<color> border-strong: #343b45;

    in-out property<color> text: #edf0f3;
    in-out property<color> text-secondary: #a1a9b3;
    in-out property<color> text-muted: #68717c;

    in-out property<color> accent: #8a9cff;
    in-out property<color> accent-hover: #9cabff;
    in-out property<color> accent-soft: #242b48;

    in-out property<color> success: #56d69a;
    in-out property<color> warning: #e5ba65;
    in-out property<color> error: #ef6f78;

    in-out property<string> font-ui: "Inter";
    in-out property<string> font-mono: "JetBrains Mono";

    in-out property<length> radius-small: 6px;
    in-out property<length> radius-medium: 9px;
    in-out property<length> radius-large: 14px;
}
